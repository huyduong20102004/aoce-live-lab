{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "types": ["node"],
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true
  },
  "include": ["playwright.config.ts", "tests/**/*.ts", "controller/**/*.ts", "reporters/**/*.ts"]
}
